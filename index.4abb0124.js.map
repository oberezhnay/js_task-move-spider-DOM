"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
document.addEventListener("click", function(e) {
    if (e.target.classList.contains("wall")) {
        var spiderWidth = parseFloat(window.getComputedStyle(spider).width);
        var spiderHeight = parseFloat(window.getComputedStyle(spider).height);
        var clickX = e.offsetX;
        var clickY = e.offsetY;
        var spiderX = clickX - spiderHeight / 2;
        var spiderY = clickY - spiderWidth / 2;
        spiderX = Math.max(0, Math.min(spiderX, wall.clientWidth - spiderWidth));
        spiderY = Math.max(0, Math.min(spiderY, wall.clientHeight - spiderHeight));
        spider.style.left = "".concat(spiderX, "px");
        spider.style.top = "".concat(spiderY, "px");
    }
});

